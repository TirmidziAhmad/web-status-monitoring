# ========================================================
# CPANEL & SERVER MONITOR TELEGRAM BOT CONFIGURATION
# ========================================================

# 1. Kredensial Telegram
# Token bot dari @BotFather di Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID Telegram penerima notifikasi (bisa akun pribadi atau grup):
# Dapatkan ID via @userinfobot atau kirim /start ke bot Anda
# Untuk beberapa admin/grup, pisahkan dengan koma: 123456789,987654321
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. Target Pemantauan Awal (Dapat diubah dinamis via bot Telegram)
# Pisahkan beberapa URL/port dengan koma:
TARGET_URLS=https://prima.rsmra.id,https://prima.rsmra.id:2083

# 3. Interval & Toleransi Gangguan (Dapat diubah dinamis via bot Telegram)
# Frekuensi pengecekan dalam detik (default: 60 detik):
CHECK_INTERVAL_SECONDS=60

# Berapa kali gagal berturut-turut sebelum membunyikan alarm DOWN:
# Rekomendasi: 3 (mencegah alarm palsu akibat koneksi internet lag sejenak)
FAILURE_THRESHOLD=3

# Pengingat saat server masih berstatus DOWN (dalam menit):
# Bot akan mengingatkan kembali jika server belum nyala setelah X menit (0 = tanpa pengingat):
REMINDER_INTERVAL_MINUTES=30

# Batas waktu tunggu respons server (timeout) dalam detik:
REQUEST_TIMEOUT_SECONDS=10

# 4. Direktori Penyimpanan Runtime Dinamis
DATA_DIR=./data
